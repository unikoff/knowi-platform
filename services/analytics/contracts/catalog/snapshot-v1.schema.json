{
  "$defs": {
    "Catalog": {
      "additionalProperties": false,
      "properties": {
        "course_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Course Id",
          "type": "string"
        },
        "lessons": {
          "items": {
            "$ref": "#/$defs/Lesson"
          },
          "title": "Lessons",
          "type": "array"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/Track"
          },
          "title": "Tracks",
          "type": "array"
        }
      },
      "required": [
        "course_id",
        "tracks",
        "lessons"
      ],
      "title": "Catalog",
      "type": "object"
    },
    "Lesson": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$",
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "lesson_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Lesson Id",
          "type": "string"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/Task"
          },
          "title": "Tasks",
          "type": "array"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "tombstone": {
          "title": "Tombstone",
          "type": "boolean"
        },
        "track_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Track Id",
          "type": "string"
        }
      },
      "required": [
        "lesson_id",
        "track_id",
        "aliases",
        "title",
        "order",
        "tombstone",
        "tasks"
      ],
      "title": "Lesson",
      "type": "object"
    },
    "Task": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$",
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Task Id",
          "type": "string"
        },
        "task_revision": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Task Revision",
          "type": "string"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "tombstone": {
          "title": "Tombstone",
          "type": "boolean"
        }
      },
      "required": [
        "task_id",
        "task_revision",
        "aliases",
        "title",
        "order",
        "tombstone"
      ],
      "title": "Task",
      "type": "object"
    },
    "Track": {
      "additionalProperties": false,
      "properties": {
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "title": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "tombstone": {
          "title": "Tombstone",
          "type": "boolean"
        },
        "track_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Track Id",
          "type": "string"
        }
      },
      "required": [
        "track_id",
        "title",
        "order",
        "tombstone"
      ],
      "title": "Track",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "catalog": {
      "$ref": "#/$defs/Catalog"
    },
    "catalog_version": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Catalog Version",
      "type": "string"
    },
    "kind": {
      "const": "analytics_catalog_snapshot",
      "title": "Kind",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "sequence",
    "catalog_version",
    "catalog"
  ],
  "title": "Snapshot",
  "type": "object"
}
